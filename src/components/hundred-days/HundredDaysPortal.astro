  { key: "readerMemos", label: "Reader editions", labelZh: "读者版本", color: "blue", href: "/investor/daily/" },
  { key: "recapDashboards", label: "Living recaps", labelZh: "动态复盘", color: "green", href: "/investor/recaps/" },
