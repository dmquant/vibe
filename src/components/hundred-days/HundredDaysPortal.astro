---

<div class:list={["hundred-days-shell", { "is-day-100": day100Complete }]} data-hundred-days-root data-initial-day={initialDay}>
  <section class:list={["century-hero", { "is-complete": day100Complete }]} id="atlas" aria-labelledby="century-title">
    <canvas id="centuryUniverse" class="century-universe" aria-label="AI Institute thesis, lane and stock universe across the first 100 days"></canvas>
    <div class="century-space-grid" aria-hidden="true"></div>
    <div class="century-hero-copy">
      <div class="century-kicker">
        <span class="century-live-dot" aria-hidden="true"></span>
        <span class="i18n-zh">{day100Complete ? "DAY 100 · 百日正式版" : "100 DAYS · THE INSTITUTION THAT LEARNS"}</span>
        <span class="i18n-en">{day100Complete ? "DAY 100 · OFFICIAL EDITION" : "100 DAYS · THE INSTITUTION THAT LEARNS"}</span>
      </div>
      <h1 id="century-title">
        <span class="i18n-zh">AI 研究院的 100 天</span>
        <span class="i18n-en">100 Days of AI Institute</span>
      </h1>
      <strong class="century-brand-line">
        <span class="i18n-zh">研究不是生成，是持续修正。</span>
        <span class="i18n-en">Research is not generated. It is continuously revised.</span>
      </strong>
      <p>
        <span class="i18n-zh">一座会留下证据、保存分歧、承认修订并持续运行的研究机构，如何在一百天里长出来。</span>
        <span class="i18n-en">How an institution that preserves evidence, keeps dissent, admits revision, and continues operating grew across one hundred days.</span>
      </p>
      <div class="century-hero-actions">
        {day100Complete && (
          <a class="century-primary-action" href={finalMemoHref}>
            <span aria-hidden="true">▣</span>
            <span class="i18n-zh">阅读第 100 天报告</span><span class="i18n-en">Read the Day 100 memo</span>
          </a>
        )}
        <button class:list={{ "century-primary-action": !day100Complete }} type="button" data-guide-open>
          <span aria-hidden="true">▶</span>
          <span class="i18n-zh">观看百日回放</span><span class="i18n-en">Watch the guided replay</span>
        </button>
        <a href="#story-arc"><span aria-hidden="true">⌁</span><span class="i18n-zh">阅读完整故事</span><span class="i18n-en">Read the full story</span></a>
        <a href="/investor/">
          <span aria-hidden="true">↗</span>
          <span class="i18n-zh">打开实时研究院</span><span class="i18n-en">Open the live Institute</span>
        </a>
      </div>
    </div>

    <aside class="century-hero-hud" aria-label="100 day portal status">
      <div class="century-brand-seal" aria-label={`${data.currentDay} of 100 days complete`}>
        {Array.from({ length: 100 }, (_, index) => (
          <i class:list={{ "is-complete": index < data.currentDay, "is-current": index + 1 === data.currentDay }}></i>
        ))}
      </div>
      <div class="century-day-lockup">
        <span>DAY</span>
        <strong id="centuryHeroDay">{String(data.currentDay).padStart(3, "0")}</strong>
        <em>/ 100</em>
      </div>
      <div class="century-progress-track" aria-label={`${data.progressPct}% complete`}>
        <i style={`--century-progress:${data.progressPct}%`}></i>
      </div>
      <dl>
        <div><dt class="i18n-zh">数据截至</dt><dt class="i18n-en">Data through</dt><dd>{data.latestDataDate}</dd></div>
        <div><dt class="i18n-zh">图谱节点</dt><dt class="i18n-en">Atlas nodes</dt><dd>{number.format(data.atlas.stats.nodes)}</dd></div>
        <div><dt class="i18n-zh">研究关系</dt><dt class="i18n-en">Relations</dt><dd>{number.format(data.atlas.stats.edges)}</dd></div>
      </dl>
      <div class="century-atlas-legend" aria-label="Atlas legend">
        <span class="legend-blue"><i></i>Lane</span>
        <span class="legend-yellow"><i></i>Thesis</span>
        <span class="legend-orange"><i></i>Stock</span>
      </div>
    </aside>

    <div id="centuryUniverseTooltip" class="century-universe-tooltip" hidden></div>
    <div class="century-hero-status" aria-live="polite">
      <span id="centuryUniverseStatus">DAY {String(initialDay).padStart(3, "0")} · {initialRecord.date}</span>
      <span class="i18n-zh">拖动旋转 · 滚轮缩放 · 点击进入节点</span>
      <span class="i18n-en">Drag to orbit · scroll to zoom · click to inspect</span>
    </div>
  </section>

  <dialog class="century-guide" id="centuryGuide" aria-labelledby="centuryGuideTitle">
    <div class="century-guide-frame">
      <header>
        <div>
          <span>100 DAYS / GUIDED REPLAY</span>
          <strong id="centuryGuideTitle" class="i18n-zh">一座会学习的研究院如何长出来</strong>
          <strong class="i18n-en">How an institution that learns took shape</strong>
        </div>
        <button type="button" data-guide-close aria-label="Close guided replay" title="Close">×</button>
      </header>
      <div class="century-guide-body">
        <nav aria-label="Guided replay chapters">
          {guideChapters.map((chapter, index) => (
            <button type="button" class:list={{ "is-active": index === 0 }} data-guide-step={index} data-guide-day={chapter.day}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <i class={`tone-${chapter.color}`}></i>
              <strong>DAY {String(chapter.day).padStart(3, "0")}</strong>
            </button>
          ))}
        </nav>
        <div class="century-guide-chapters">
          {guideChapters.map((chapter, index) => (
            <article class:list={[`tone-${chapter.color}`, { "is-active": index === 0 }]} data-guide-chapter={index}>
              <span>{chapter.code}</span>
              <h2 class="i18n-zh">{chapter.titleZh}</h2><h2 class="i18n-en">{chapter.titleEn}</h2>
              <p class="i18n-zh">{chapter.bodyZh}</p><p class="i18n-en">{chapter.bodyEn}</p>
              <div>
                <a href={`/100-days/day/${data.days.find((day) => day.dayNumber === chapter.day)?.date || data.latestDataDate}/`}>
                  <span class="i18n-zh">打开这一天</span><span class="i18n-en">Open this day</span> ↗
                </a>
                <em>{data.days.find((day) => day.dayNumber === chapter.day)?.date}</em>
              </div>
            </article>
          ))}
        </div>
      </div>
      <footer>
        <div class="century-guide-progress"><i id="centuryGuideProgress"></i></div>
        <div class="century-guide-controls">
          <button type="button" id="centuryGuidePrev" aria-label="Previous chapter" title="Previous chapter">←</button>
          <button type="button" id="centuryGuidePlay" aria-label="Play guided replay" title="Play guided replay">▶</button>
          <button type="button" id="centuryGuideNext" aria-label="Next chapter" title="Next chapter">→</button>
          <a href="#daily-field" data-guide-explore><span class="i18n-zh">进入完整时间线</span><span class="i18n-en">Enter the full timeline</span></a>
        </div>
      </footer>
    </div>
  </dialog>

  <nav class="century-section-nav" aria-label="100 days portal sections">
    <a href="#story"><span>01</span><strong class="i18n-zh">故事</strong><strong class="i18n-en">Story</strong></a>
    <a href="#proof"><span>02</span><strong class="i18n-zh">证据</strong><strong class="i18n-en">Proof</strong></a>
    <a href="#daily-field"><span>03</span><strong class="i18n-zh">每日</strong><strong class="i18n-en">Daily</strong></a>
    <a href="#research-river"><span>04</span><strong class="i18n-zh">研究流</strong><strong class="i18n-en">River</strong></a>
    <a href="#episodes"><span>05</span><strong class="i18n-zh">事件库</strong><strong class="i18n-en">Episodes</strong></a>
    <a href="#institution"><span>06</span><strong class="i18n-zh">机构</strong><strong class="i18n-en">Institution</strong></a>
    <a href="#operating-proof"><span>07</span><strong class="i18n-zh">运行证据</strong><strong class="i18n-en">Operations</strong></a>
    <a href="#scorecard"><span>08</span><strong class="i18n-zh">记分卡</strong><strong class="i18n-en">Scorecard</strong></a>
    <a href="/investor/"><span>↗</span><strong>Live</strong></a>
  </nav>

  <main class="century-main">
    {day100Complete && (
      <section class="century-day100-finale" id="day-100" aria-labelledby="century-day100-title">
        <div class="century-day100-mark" aria-hidden="true">
          <span>DAY</span>
          <strong>100</strong>
          <em>COMPLETE</em>
          <div>
            {["blue", "green", "yellow", "orange", "red"].map((color) => <i class={`tone-${color}`}></i>)}
          </div>
        </div>

        <div class="century-day100-copy">
          <span>2026-04-22 → {finalDayRecord.date} / 100 · 100</span>
          <h2 id="century-day100-title" class="i18n-zh">第一段可审计的研究周期，今天完成。</h2>
          <h2 class="i18n-en">The first auditable research cycle closes today.</h2>
          <p class="i18n-zh">证据、分歧、修订、复盘与组合映射被保存在同一条公开时间线上。百日版本从今天起成为固定历史快照；第 101 天之后的研究继续在实时研究院。</p>
          <p class="i18n-en">Evidence, dissent, revision, recap, and portfolio mapping now share one public timeline. This edition becomes a fixed historical snapshot while live research continues beyond Day 100.</p>
        </div>

        <article class="century-day100-memo">
          <span>DAY 100 / DECISION MEMO</span>
          <h3 class="i18n-zh">{finalMemoTitle}</h3>
          <h3 class="i18n-en">{finalMemoTitleEn}</h3>
          <p class="i18n-zh">{finalMemoSummary}</p>
          <p class="i18n-en">{finalMemoSummaryEn}</p>
          <div>
            <a href={finalMemoHref}><span class="i18n-zh">阅读今日报告</span><span class="i18n-en">Read today's memo</span><i aria-hidden="true">↗</i></a>
            <button type="button" data-day100-jump><span class="i18n-zh">在时间线中打开</span><span class="i18n-en">Open in timeline</span><i aria-hidden="true">↓</i></button>
