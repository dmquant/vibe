      { date: "06-02", labelZh: "完成首轮观点复盘", labelEn: "Complete the first thesis recap", href: "/investor/reports/recap-mag7-next-era-losers-recap-2026-06-02/" },
      { date: "LIVE", labelZh: "跟踪动态论点", labelEn: "Track the living thesis", href: "/investor/theses/thesis-8c5a9690a0/" },
    ],
  },
  {
    code: "03 / CHINA INDEX EVENTS",
    color: "orange",
    titleZh: "科创 50 与 MSCI：让判断接受时间检验",
