---
import { operatingProof } from "../../lib/hundred-days-operating-proof.js";
import { hundredDaysNarrative } from "../../lib/hundred-days-narrative.js";

const { data } = Astro.props;
const initialDay = Math.max(1, Math.min(data.dayCount, data.latestDataDay || data.currentDay || 1));
