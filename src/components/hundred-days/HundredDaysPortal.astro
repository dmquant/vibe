  { key: "publicEdges", label: "Evidence relations", labelZh: "证据关系", color: "orange", href: "/investor/research-network/" },
];
const day100Complete = data.currentDay >= data.dayCount && data.latestDataDay >= data.dayCount;
const finalDayRecord = data.days.find((day) => day.dayNumber === data.dayCount) || initialRecord;
const finalReader = data.episodes.find((episode) => episode.date === finalDayRecord.date && episode.type === "reader");
const finalMemoTitle = finalReader?.title || finalDayRecord.headline;
const finalMemoSummary = finalReader?.summary || finalDayRecord.summary;
const finalMemoTitleEn = finalReader?.titleEn || `${finalDayRecord.date}: AI scarcity shifts from aggregate capex to powered conversion and return validation`;
const finalMemoSummaryEn = finalReader?.summaryEn || "The Day 100 filter shifts from broad AI capex growth to secured power, locked equipment slots, verifiable revenue, and lower crowding. Grid equipment ranks first, HBM stays selective, while unpowered projects, high-beta equipment, and capex without revenue anchors deserve a wider discount.";
const finalMemoHref = finalReader?.href || "/investor/daily/";
const day100ScoreItems = [
  { key: "reports", labelZh: "公开研究", labelEn: "Published research", color: "blue" },
  { key: "researchThreads", labelZh: "研究讨论", labelEn: "Research discussions", color: "green" },
  { key: "theses", labelZh: "动态论点", labelEn: "Living theses", color: "yellow" },
  { key: "lanes", labelZh: "投资赛道", labelEn: "Investable lanes", color: "orange" },
  { key: "stocks", labelZh: "股票节点", labelEn: "Stock nodes", color: "red" },
  { key: "readerMemos", labelZh: "读者版本", labelEn: "Reader editions", color: "blue" },
];

