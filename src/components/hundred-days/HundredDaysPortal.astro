              {replay.steps.map((step) => (
                <li>
                  <span>{step.date}</span>
                  <a href={step.href}><strong class="i18n-zh">{step.labelZh}</strong><strong class="i18n-en">{step.labelEn}</strong><em>↗</em></a>
